// Template: build.rs fills in the @...@ placeholders and compiles the result from OUT_DIR.
// The version comes from Cargo.toml; do not hard-code it here.
1 ICON "@ICON@"
1 24 "@MANIFEST@"

1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "zPDF\0"
            VALUE "FileVersion", "@PKG_VERSION@\0"
            VALUE "InternalName", "zpdf\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 zaczzk\0"
            VALUE "OriginalFilename", "zpdf.exe\0"
            VALUE "ProductName", "zPDF\0"
            VALUE "ProductVersion", "@PKG_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
